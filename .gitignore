# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/
.junie

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
build/
schema.graphql

# FVM Version Cache
.fvm*
.vscode*

.claude
.agents
.specify

.memsearch

# --- forklift: fleet extension set (committed on purpose) ---
# The `.**` rule above ignores every dotfile, which would swallow the payload a
# cloud lane needs: .specify/extensions/** (the assess/triage commands) and the
# .agents/.kimi-code skill files they register. Re-include them explicitly.
!.specify/
.specify/*
!.specify/extensions/
!.specify/extensions.yml
!.specify/memory/
.specify/memory/*
!.specify/memory/constitution.md
!.agents/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/speckit-*/
!.kimi-code/
.kimi-code/*
!.kimi-code/skills/
.kimi-code/skills/*
!.kimi-code/skills/speckit-*/
